<?xml version="1.0" encoding="utf-8"?>
<!--
  Meta-data for AssistService (VoiceInteractionService).
  Declares the assistant's capabilities:
   - supportsAssist=true → system calls AssistSession.onHandleAssist() with
     the current screen's AssistStructure + AssistContent.
   - recognitionService → optional custom ASR. We leave it unset and reuse the
     system SpeechRecognizer, so the system's default recognition is used.
-->
<voice-interaction-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:supportsAssist="true"
    android:supportsLaunchVoiceAssistFromKeyguard="false"
    android:supportsLocalInteraction="true" />
