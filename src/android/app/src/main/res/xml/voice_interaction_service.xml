<?xml version="1.0" encoding="utf-8"?>
<!--
  Meta-data for AssistService (VoiceInteractionService).
  Declares the assistant's capabilities:
   - supportsAssist=true → system calls AssistSession.onHandleAssist() with
     the current screen's AssistStructure + AssistContent.
   - recognitionService → required by the framework for the ASSISTANT role
     qualification; points at MinisRecognitionService, which delegates to the
     system SpeechRecognizer (no self-built ASR).
-->
<voice-interaction-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:supportsAssist="true"
    android:supportsLaunchVoiceAssistFromKeyguard="false"
    android:supportsLocalInteraction="true"
    android:sessionService=".assist.AssistSessionService"
    android:recognitionService=".assist.MinisRecognitionService" />
