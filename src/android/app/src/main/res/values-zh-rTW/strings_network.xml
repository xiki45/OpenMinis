    <string name="network_proxy_password">密碼</string>
    <string name="network_proxy_bypass">自動允許</string>
    <string name="network_proxy_bypass_footer">這些主機直接連線。多個項目以逗號或換行分隔；「*.example.com」也符合子網域。本機位址一律不經代理伺服器。</string>
